DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Cabeceras de Autorizacion y Cookies para Laravel
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 2. Rutas del Backend (API y Sanctum) -> ejecutar index.php de Laravel
    RewriteCond %{REQUEST_URI} ^/api [NC,OR]
    RewriteCond %{REQUEST_URI} ^/sanctum [NC]
    RewriteRule ^ index.php [L]

    # 3. Archivos estaticos existentes (imagenes, JS, CSS de React)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Todas las demas rutas (/catalogo, /login, /admin, /) -> index.html de React
    RewriteRule ^ index.html [L]
</IfModule>
